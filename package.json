{
  "name": "autobuilder-for-c",
  "displayName": "AutoBuilder for c++",
  "description": "Useful extension that allows you to build projects automatically without ever using command line",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "publisher": "shippingsink",
  "author": {
    "name": "Stepan"
  },
  "icon": "img/result_icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "autobuilder-for-c.createStructure",
        "title": "CMake: Create basic project structure"
      },
      {
        "command": "autobuilder-for-c.buildProject",
        "title": "CMake: Build and Run the project",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "autobuilder-for-c.buildProject",
          "group": "navigation",
          "when": "editorLangId == cpp || editorLangId == c"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
